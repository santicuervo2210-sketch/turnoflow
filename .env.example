APP_NAME=TurnoFlow
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/turnoflow
AUTO_CREATE_TABLES=false
BOT_AI_PROVIDER=rules
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=8
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploy
SESSION_SECRET=change-this-long-random-secret-before-deploy
BOT_WEBHOOK_SECRET=change-this-long-random-webhook-secret-before-deploy
ERROR_ALERT_WEBHOOK_URL=
LOGIN_RATE_LIMIT_PER_MINUTE=30
BOT_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
DATABASE_POOL_MODE=serverless
CRON_SECRET=change-this-long-random-cron-secret-before-deploy
BOT_CONVERSATION_TTL_DAYS=30
WEBHOOK_RECEIPT_TTL_DAYS=30

# Demo local rapida sin PostgreSQL:
# DATABASE_URL=sqlite+pysqlite:///./turnoflow.db
# AUTO_CREATE_TABLES=true
# BOT_AI_PROVIDER=ollama
